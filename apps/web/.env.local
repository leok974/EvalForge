# Local Development Configuration
# This file overrides .env for local dev

# Proxy backend to local server
VITE_PROXY_TARGET=http://127.0.0.1:8092

# Enable dev-mode fake auth (no GitHub OAuth)
VITE_DEV_FAKE_AUTH=1

# Enable all layout features
VITE_LAYOUT_CYBERDECK_V2=1
VITE_FX_ENABLED=1
VITE_LAYOUT_ORION_ENABLED=1

# God Mode - Unlock All Features (optional)
VITE_DEV_UNLOCK_ALL=0
VITE_UNLOCK_ALL=0
