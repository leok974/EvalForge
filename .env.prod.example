# EvalForge Production Secrets
# Copy this file to .env.prod and fill in your values
# DO NOT commit .env.prod to git!

# GitHub OAuth Application Credentials
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_secret_here

# JWT Secret Key for session tokens
# Generate with: openssl rand -hex 32
SECRET_KEY=your_random_32_char_secret_key_here
