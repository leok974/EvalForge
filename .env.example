# EvalForge environment configuration
# Copy this file to .env and fill in the values for your environment.
# Docker Compose reads .env automatically.

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# Used by docker-compose to set the postgres container password.
# Also used by get_database_url() if DATABASE_URL is not explicitly set.
POSTGRES_PASSWORD=change_me

# Override the full database URL if needed (e.g. for external RDS).
# If unset, the app constructs a URL from host/port defaults.
# DATABASE_URL=postgresql+asyncpg://evalforge:change_me@db:5432/evalforge

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# If unset, defaults to redis://redis:6379/0 inside Docker.
# REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Google Cloud / Vertex AI (required for real AI grading and coaching)
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Optional: path to service account JSON inside the container.
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json

# ---------------------------------------------------------------------------
# GitHub OAuth (required when EVALFORGE_AUTH_MODE=github)
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# App secret key (signing sessions / CSRF tokens)
# ---------------------------------------------------------------------------
SECRET_KEY=change_me_to_a_long_random_string

# ---------------------------------------------------------------------------
# Gemini API key (alternative to Vertex AI for model calls)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# EvalForge runtime flags
# ---------------------------------------------------------------------------

# EVALFORGE_MOCK_GRADING
#   "1" = skip real AI grading; return deterministic stub results (dev/test only)
#   "0" or unset = use Vertex AI / Gemini for quest evaluation
# WARNING: Never set to "1" in production — learners receive fake feedback.
EVALFORGE_MOCK_GRADING=1

# EVALFORGE_AUTH_MODE
#   "mock"   = no real authentication; any request gets a dev user (dev only)
#   "github" = GitHub OAuth flow (production)
# WARNING: Never set to "mock" in production.
EVALFORGE_AUTH_MODE=mock

# AUTO_INIT_DB
#   "1" = run Alembic migrations automatically on startup (dev convenience)
#   "0" = do not auto-migrate (production; run migrations explicitly)
AUTO_INIT_DB=1
