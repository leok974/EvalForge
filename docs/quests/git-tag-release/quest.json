{
    "slug": "git-tag-release",
    "title": "Git Tags: Release v1.0.0",
    "language": "bash",
    "world_id": "world-git",
    "track_id": "track-git-core",
    "order_index": 9,
    "grading": {
        "mode": "tests"
    },
    "workspace": {
        "entrypoint": "task.sh",
        "files_from": "./starter"
    },
    "objectives": [
        {
            "id": "fs_snapshot",
            "kind": "fs_snapshot",
            "title": "Verify file structure",
            "rule": {
                "kind": "fs_snapshot",
                "must_exist": [
                    "README.md",
                    "task.sh",
                    "wrapper.sh"
                ]
            }
        },
        {
            "id": "git_status_clean",
            "kind": "git_status_clean",
            "title": "Clean git status",
            "rule": {
                "kind": "git_status_clean",
                "expected_porcelain": ""
            }
        },
        {
            "id": "git_log_contains",
            "kind": "git_log_contains",
            "title": "Verify commit history",
            "rule": {
                "kind": "git_log_contains",
                "must_contain": [
                    "Initial commit"
                ],
                "min_commits": 1
            }
        }
    ]
}