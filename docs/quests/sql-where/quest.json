{
    "slug": "sql-where",
    "title": "Filter Rows",
    "language": "sql",
    "world_id": "world-sql",
    "track_id": "core",
    "order_index": 2,
    "short_description": "Filtering with Purpose",
    "detailed_description": "Return only ACTIVE users from Detroit.",
    "objectives": [
        {
            "id": "obj_runs",
            "kind": "tests_pass",
            "text": "Query executes successfully",
            "why": "Functional requirement",
            "rule": {
                "must_pass": true
            }
        },
        {
            "id": "obj_has_where",
            "kind": "source_regex",
            "text": "Query uses WHERE clause",
            "why": "Required for filtering",
            "rule": {
                "regex": "(?i)\\bWHERE\\b",
                "must_match": true
            }
        },
        {
            "id": "obj_filters",
            "kind": "source_regex",
            "text": "Query filters by city and active status",
            "why": "Requires multiple conditions",
            "rule": {
                "regex": "(?i)city\\s*=\s*'Detroit'.*(?i)AND.*(?i)is_active\\s*=\s*1|(?i)is_active\\s*=\s*1.*(?i)AND.*(?i)city\\s*=\s*'Detroit'",
                "must_match": true
            }
        },
        {
            "id": "obj_order",
            "kind": "source_regex",
            "text": "Query sorts by name ascending",
            "why": "Sorting requirement",
            "rule": {
                "regex": "(?i)ORDER\\s+BY\\s+name\\s+(?:ASC)?",
                "must_match": true
            }
        }
    ],
    "grading": {
        "mode": "tests",
        "expected_columns": [
            "name",
            "city"
        ]
    },
