{
    "slug": "git-ignition",
    "title": "Git Ignition",
    "trigger": {
        "open_file": "workspace/README.md"
    },
    "grading": {
        "public_tests": [
            "grading/public/git-ignition.public.test.mjs"
        ]
    },
    "objectives": [
        {
            "id": "fs_snapshot",
            "kind": "fs_snapshot",
            "title": "Verify file structure",
            "rule": {
                "kind": "fs_snapshot",
                "must_exist": [
                    "README.md",
                    "main.py",
                    "task.sh"
                ]
            }
        },
        {
            "id": "git_log_contains",
            "kind": "git_log_contains",
            "title": "Verify commit history",
            "rule": {
                "kind": "git_log_contains",
                "must_contain": [
                    "Initial commit"
                ],
                "min_commits": 1
            }
        }
    ]
}