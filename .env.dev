# EvalForge — local dev defaults
# -----------------------------------------------------------------------
# SAFE TO COMMIT: no real credentials in this file.
# Every sensitive value has been replaced with a safe placeholder.
#
# On a fresh clone, copy this file to .env to bootstrap the dev stack:
#   cp .env.dev .env          (Linux / macOS / Git Bash)
#   copy .env.dev .env        (Windows cmd)
#
# Then fill in real values for any cloud features you actually need:
#   GEMINI_API_KEY      — Google AI Studio key for Vertex AI
#   GITHUB_CLIENT_*     — GitHub OAuth App for login (only needed if
#                         EVALFORGE_AUTH_MODE=github)
#   VERTEX_PROJECT_*    — your GCP project if using Vertex AI
#
# For local-only development, mock mode works without any of those.
# -----------------------------------------------------------------------

# DevDiag HTTP Proxy Configuration
DEVDIAG_BASE=http://127.0.0.1:8023
DEVDIAG_JWT=

# Vertex AI Configuration (fill in your own GCP project to use Vertex AI)
VERTEX_PROJECT_NUMBER=
VERTEX_PROJECT_ID=evalforge-dev-local
VERTEX_REGION=us-central1
VERTEX_MODEL_ID=gemini-2.5-flash

# Google Cloud Configuration (fill in your own project if using Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_AGENT_ENGINE_ID=

# EvalForge Features
EVALFORGE_PORT=19010
EVALFORGE_ENV=dev
EVALFORGE_ENABLE_GREETER=1
EVALFORGE_ENABLE_JUDGE=1
EVALFORGE_ENABLE_COACH=1
EF_COACH_ENABLED=1
GEMINI_API_KEY=
EVALFORGE_DEV_INTROSPECTION=1
EVALFORGE_ENABLE_MCP=1
EVALFORGE_EVENT_LOG=1

# Database Configuration (matches docker-compose.yml defaults — no change needed)
DATABASE_URL=postgresql+asyncpg://evalforge:evalforge@localhost:5435/evalforge

# Authentication
# EVALFORGE_AUTH_MODE=mock lets the dev stack run without GitHub OAuth.
# Switch to github (and fill in GITHUB_CLIENT_* below) for OAuth testing.
EVALFORGE_AUTH_MODE=mock
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SECRET_KEY=dev-secret-do-not-use-in-production

# Mock grading: any code → loss; code containing MAGIC_BOSS_PASS → win.
# Required for e2e tests. Must NOT be set in production.
EVALFORGE_MOCK_GRADING=1
