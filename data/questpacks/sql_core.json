                },
                {
                    "id": "obj_has_where",
                    "kind": "source_regex",
                    "title": "Query uses WHERE clause",
                    "rule": {
                        "pattern": "(?i)\\bWHERE\\b"
                    }
                },
                {
                    "id": "obj_filters",
                    "kind": "source_regex",
                    "title": "Query filters by city and active status",
                    "rule": {
                        "patterns": [
                            "(?i)city\\s*=\\s*'Detroit'",
                            "(?i)AND",
                            "(?i)is_active\\s*=\\s*1"
                        ]
                    }
                },
                {
                    "id": "obj_order",
                    "kind": "source_regex",
                    "title": "Query sorts by name ascending",
                    "rule": {
                        "pattern": "(?i)ORDER\\s+BY\\s+name\\s+(?:ASC)?"
                    }
                }
            ]
