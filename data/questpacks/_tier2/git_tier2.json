            "description": "Resolve a merge conflict between two branches.",
            "starter_code": "# No starter code, git repo provided",
            "objectives": [
                {
                    "id": "git_status_clean",
                    "title": "Working tree clean (conflict resolved)",
                    "kind": "git_status_clean"
                },
                {
                    "id": "git_log_contains",
                    "title": "Merge commit exists",
                    "kind": "git_log_contains",
                    "rule_json": {
                        "pattern": "Merge branch"
                    }
                },
                {
                    "id": "fs_no_conflict_markers",
                    "title": "No conflict markers in file.txt",
                    "kind": "fs_file_content_regex",
                    "rule_json": {
                        "path": "file.txt",
                        "pattern": "<<<<<<<",
                        "negate": true
                    }
                }
            ],
            "key_terms": [
                "glossary/git/merge-conflict",
