                {
                    "id": "tests_pass",
                    "title": "Query returns correct result",
                    "kind": "tests_pass"
                },
                {
                    "id": "source_groupby_having_aggregate",
                    "title": "Uses GROUP BY + HAVING on an aggregate",
                    "kind": "source_regex",
                    "rule": {
                        "patterns": [
                            "(?is)\\bgroup\\s+by\\b",
